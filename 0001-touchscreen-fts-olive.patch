+/* Works only for digits and letters, but small and fast */
+#define TOLOWER(x) ((x) | 0x20)
+static int fts_strncmp(const char *cs, const char *ct, int count)
+{
+	u8 c1 = 0, c2 = 0;
+
+	while (count) {
+		if  ((*cs == '\0') || (*ct == '\0'))
+			return -EIO;
+		c1 = TOLOWER(*cs++);
+		c2 = TOLOWER(*ct++);
+		if (c1 != c2)
+			return c1 < c2 ? -1 : 1;
+		if (!c1)
+			break;
+		count--;
+	}
+
+	return 0;
+}
+
+static int isspace(int x)
+{
+	if (x == ' ' || x == '\t' || x == '\n' || x == '\f' || x == '\b'
+	    || x == '\r')
+		return 1;
+	else
+		return 0;
+}
