+static int fts_test_get_ini_size(char *config_name)
+{
+	struct file *pfile = NULL;
+	struct inode *inode = NULL;
+	struct filename *vts_name;
+	off_t fsize = 0;
+	char filepath[FILE_NAME_LENGTH] = { 0 };
+
+	FTS_TEST_FUNC_ENTER();
+
+	memset(filepath, 0, sizeof(filepath));
+	snprintf(filepath, FILE_NAME_LENGTH,
+	"%s%s", FTS_INI_FILE_PATH, config_name);
+
+	if (NULL == pfile) {
+		vts_name = getname_kernel(filepath);
+		pfile = file_open_name(vts_name, O_RDONLY, 0);
+	}
+	if (IS_ERR(pfile)) {
+		FTS_TEST_ERROR("error occured while opening file %s.",  filepath);
+		return -EIO;
+	}
+
+	inode = pfile->f_inode;
+	fsize = inode->i_size;
+	filp_close(pfile, NULL);
+
+	FTS_TEST_FUNC_ENTER();
+
+	return fsize;
