 	case POWER_SUPPLY_PROP_TEMP:
-		return gab_read_channel(adc_bat, GAB_TEMP, &val->intval);
+		ret = gab_read_channel(adc_bat, GAB_TEMP, &val->intval);
+		if (ret < 0)
+			return ret;
+		val->intval /= 1000;
+		return 0;
 	default:
 		return -EINVAL;
 	}
