+	FTS_TEST_SAVE_INFO("\n");
+
+	FTS_TEST_SAVE_INFO("SCap Tx: ");
+	for (i = tdata->sc_node.rx_num; i < tdata->sc_node.node_num; i++)
+		FTS_TEST_SAVE_INFO("%5d, ", data[i]);
+	FTS_TEST_SAVE_INFO("\n");
+}
+/* mc_sc end*/
